# ─── Firebase Project Config ─────────────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ─── Google Maps ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Google Places (OPTIONAL destination enrichment) ────────────────────────
# TICS discovers destinations from OpenStreetMap first. Google Places is an
# OPTIONAL enrichment provider. Set to "false" to disable it completely —
# Explore, Nearby, Weekend Escape, Search and destination details all work.
TICS_ENABLE_GOOGLE_PLACES=true
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# ─── GeoNames (optional search/enrichment provider) ─────────────────────────
EXPO_PUBLIC_GEONAMES_USERNAME=


# ─── External APIs ────────────────────────────────────────────────────────────
# OpenWeatherMap API Key for weather data (get yours at https://openweathermap.org/api)
EXPO_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# REST Countries API Key (get yours at https://restcountries.com/)
EXPO_PUBLIC_RESTCOUNTRIES_API_KEY=your_restcountries_api_key_here

# ─── Google Sign-In (native) ─────────────────────────────────────────────────
# Only EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID is required for native Google Sign-In
# via @react-native-google-signin/google-signin.
# Find this in Google Cloud Console → APIs & Services → Credentials → Web Client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=