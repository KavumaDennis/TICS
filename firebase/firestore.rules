rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── Helpers ───────────────────────────────────────────────────────── */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isIsoString(s) {
      return s is string && s.size() >= 16;
    }

    function isOperator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['role'])
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['operator', 'admin'];
    }

    function isTravelerOfTrip(tripId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/trips/$(tripId))
        && get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid;
    }

    function isTravelerOfAssignment(assignmentId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/assignments/$(assignmentId))
        && get(/databases/$(database)/documents/assignments/$(assignmentId)).data.travelerId == request.auth.uid;
    }

    function ownsTrip(tripId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/trips/$(tripId))
        && get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid;
    }

    /* ── Users ─────────────────────────────────────────────────────────── */

    match /users/{userId} {
      allow read: if isOwner(userId) || isOperator() || (isSignedIn() && resource.data.role == 'operator');

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'email','name','phone','devicePushTokens','premium',
          'travel_behavior','averageRating','totalRatings',
          'role','lodgeName','country',
          'createdAt','updatedAt'
        ])
        && request.resource.data.email is string;

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email','name','phone','photoURL','devicePushTokens',
          'travel_behavior','averageRating','totalRatings',
          'role','lodgeName','logoUrl','description',
          'location','country','contactPhone','contactEmail',
          'availableDrivers','website','languages',
          'recentlyViewed',
          'updatedAt'
        ])
        && !('premium' in request.resource.data.diff(resource.data).affectedKeys());

      allow delete: if isOwner(userId);

      match /saved/{savedId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.uid == userId;
        allow update, delete: if isOwner(userId);
      }

      match /ratings/{ratingId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /recommendationCache/{cacheId} {
        allow read, write: if isOwner(userId);
      }

      match /destinationInteractions/{interactionId} {
        allow read, write: if isOwner(userId);
      }

      match /destinationScores/{scoreId} {
        allow read, write: if isOwner(userId);
      }
    }

    /* ── Operators ──────────────────────────────────────────────────────── */

    match /operators/{operatorId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.keys().hasOnly([
        'averageRating', 'totalRatings', 'updatedAt'
      ]);
      allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'averageRating', 'totalRatings', 'updatedAt'
      ]) || (isSignedIn() && request.auth.uid == operatorId);
      allow delete: if isOperator();
    }

    /* ── Trips ─────────────────────────────────────────────────────────── */

    match /trips/{tripId} {

      allow read: if (
        isSignedIn()
        && resource.data.userId == request.auth.uid
      ) || isOperator();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.from is string
        && request.resource.data.to is string
        && isIsoString(request.resource.data.departureTime)
        && isIsoString(request.resource.data.arrivalTime);

      allow update: if isSignedIn()
        && (
          // Traveler can update their own trip
          (resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId)
          // Operator can update last-mile operational fields only
          || (isOperator()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMileStatus', 'assignmentId', 'assignedDriverId', 'pickupEta', 'updatedAt'
            ]))
        );

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      /* ── Trip Alerts ─────────────────────────────────────────────── */

      match /alerts/{alertId} {

        allow read: if ownsTrip(tripId) || isOperator();

        allow update: if ownsTrip(tripId)
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['read']);

        allow create, delete: if false;
      }

      /* ── Trip Recommendations ────────────────────────────────────── */

      match /recommendations/{recId} {
        allow read: if ownsTrip(tripId) || isOperator();
        allow write: if false;
      }

      /* ── Trip Weather ────────────────────────────────────────────── */

      match /weather_monitoring/{docId} {
        allow read: if ownsTrip(tripId) || isOperator();
        allow write: if false;
      }

      /* ── Trip Flight Monitoring ─────────────────────────────────── */

      match /flight_monitoring/{docId} {
        allow read: if ownsTrip(tripId) || isOperator();
        allow write: if false;
      }

      /* ── Trip Monitoring ────────────────────────────────────────── */

      match /monitoring/{docId} {
        allow read: if ownsTrip(tripId) || isOperator();
        allow write: if false;
      }

      /* ── Shared Updates ─────────────────────────────────────────── */

      match /sharedUpdates/{updateId} {
        allow read: if ownsTrip(tripId) || isOperator();
        allow write: if false;
      }
    }

    /* ── Flat Alerts ─────────────────────────────────────────────────── */

    match /alerts/{alertId} {

      allow read: if (
        isSignedIn()
        && resource.data.userId == request.auth.uid
      ) || isOperator();

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['read']);

      allow create, delete: if false;
    }

    /* ── Flat Recommendations ───────────────────────────────────────── */

    match /recommendations/{recId} {

      allow read: if (
        isSignedIn()
        && resource.data.userId == request.auth.uid
      ) || isOperator();

      allow write: if false;
    }

    /* ── Transport Options ──────────────────────────────────────────── */

    match /transport_options/{optId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    /* ── Monitoring Collections ────────────────────────────────────── */

    match /weather_monitoring/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /flight_monitoring/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    /* ── Mobility ──────────────────────────────────────────────────── */

    match /mobility/{docId} {
      allow read, write: if isSignedIn();
    }

    /* ── Assignments ───────────────────────────────────────────────── */

    match /assignments/{assignmentId} {

      allow read: if (
        isSignedIn()
        && resource.data.travelerId == request.auth.uid
      ) || isOperator();

      allow create: if isOperator();

      allow update: if isOperator()
        // OR the traveler who owns this assignment can update ride tracking fields
        || (isTravelerOfAssignment(assignmentId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'driverArrivedAt', 'rideStartedAt', 'completedAt',
              'destination', 'destinationLat', 'destinationLng',
              'currentLat', 'currentLng', 'distanceRemaining',
              'rideDurationSeconds', 'finalDistanceMeters',
              'updatedAt'
            ]));

      allow delete: if false;
    }

    /* ── Drivers ───────────────────────────────────────────────────── */

    match /drivers/{driverId} {

      allow read: if isSignedIn()
        && (
          // Admin can read all drivers
          isOperator()
          // Operator can only read their own drivers
          || (isSignedIn()
            && resource.data.operatorId == request.auth.uid)
        );

      allow create: if isOperator()
        && request.resource.data.operatorId == request.auth.uid;

      allow update: if isOperator()
        && resource.data.operatorId == request.auth.uid
        && request.resource.data.operatorId == request.auth.uid;

      allow delete: if isOperator()
        && resource.data.operatorId == request.auth.uid;
    }

    /* ── Destinations (metadata) ─────────────────────────────── */

    match /destinations/{destinationId} {
      allow read: if isSignedIn();
      allow write: if isOperator();
    }

    /* ── Country Images Cache (Pexels) ──────────────────────────── */

    match /country_images/{countryCode} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['country', 'images', 'updatedAt'])
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 5;
      allow delete: if false;
    }

    /* ── Trip Pickup Preferences ─────────────────────────────────── */

    match /tripPickupPreferences/{tripId} {
      allow read: if isSignedIn()
        && resource.data.travelerId == request.auth.uid;
      allow create, update: if isSignedIn()
        && request.resource.data.travelerId == request.auth.uid
        && request.resource.data.tripId == tripId
        && request.resource.data.keys().hasOnly(['tripId', 'travelerId', 'pickupLocation', 'dropoffLocation', 'driverNotes', 'updatedAt']);
      allow delete: if false;
    }

    /* ── App Ratings ──────────────────────────────────────────────── */

    match /app_ratings/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    /* ── Assistant Conversations ─────────────────────────────────── */

    match /assistant_conversations/{conversationId} {

      allow read: if isSignedIn()
        && conversationId.matches(request.auth.uid + '_.*');

      match /assistant_messages/{msgId} {

        allow read: if isSignedIn()
          && conversationId.matches(request.auth.uid + '_.*');

        allow create, update, delete: if false;
      }
    }

    /* ── Traveler ↔ Operator Relationship ──────────────────────────── */

    match /travelerOperators/{docId} {
      allow read: if isSignedIn() && (
        resource.data.travelerId == request.auth.uid
        || isOperator()
      );
      allow create: if isSignedIn() && (
        request.resource.data.travelerId == request.auth.uid
        || isOperator()
      );
      allow update: if isSignedIn() && (
        resource.data.travelerId == request.auth.uid
        || isOperator()
      );
      allow delete: if false;
    }

    /* ── Ride Requests ─────────────────────────────────────────────── */

    match /rideRequests/{docId} {
      allow read: if isSignedIn() && (
        resource.data.travelerId == request.auth.uid
        || isOperator()
      );
      allow create: if isSignedIn() && (
        request.resource.data.travelerId == request.auth.uid
        || isOperator()
      );
      allow update: if isSignedIn() && (
        resource.data.travelerId == request.auth.uid
        || isOperator()
      );
      allow delete: if false;
    }

    /* ── Rides (completed ride records) ────────────────────────────── */

    match /rides/{docId} {
      allow read: if isSignedIn() && (
        resource.data.travelerId == request.auth.uid
        || isOperator()
      );
      allow create: if isOperator();
      allow update: if isOperator();
      allow delete: if false;
    }

    /* ── Traveler Locations (live GPS) ─────────────────────────────── */

    match /travelerLocations/{travelerId} {
      allow read: if isSignedIn() && (
        travelerId == request.auth.uid
        || isOperator()
      );
      allow create, update: if isSignedIn() && (
        travelerId == request.auth.uid
        || isOperator()
      );
      allow delete: if false;
    }

    /* ── Driver Locations (live GPS) ───────────────────────────────── */

    match /driverLocations/{driverId} {
      allow read: if isSignedIn() && (
        isOperator()
        || resource.data.driverId == request.auth.uid
      );
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    /* ── Notifications ─────────────────────────────────────────────── */

    match /notifications/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    /* ── Trip History (timeline) ───────────────────────────────────── */

    match /tripHistory/{docId} {
      allow read: if isSignedIn() && (
        resource.data.travelerId == request.auth.uid
        || isOperator()
      );
      allow create: if isOperator();
      allow update: if isOperator();
      allow delete: if false;
    }

    /* ── AI Assistant Conversations (new structure) ───────────────── */

    match /users/{userId}/conversations/{conversationId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'summary', 'lastMessage', 'status', 'messageCount', 'updatedAt'
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isOwner(userId);
        allow create: if false;  // Only through callable function
        allow update, delete: if false;
      }
    }

    /* ── AI Assistant Memory (new structure) ─────────────────────── */

    match /users/{userId}/memory/{docId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAny(['preferences', 'importantFacts', 'updatedAt']);
      allow delete: if false;
    }

    /* ── Explore Module Collections ───────────────────────────────── */
    
    match /exploreCategories/{docId} {
      allow read: if isSignedIn();
      allow write: if isOperator();
    }
    
    match /destinations/{docId} {
      allow read: if isSignedIn();
      allow write: if isOperator();
      allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['popularity']);
    }
    
    match /events/{docId} {
      allow read: if isSignedIn();
      allow write: if isOperator();
    }
    
    match /journeyFeed/{docId} {
      allow read: if isSignedIn();
      allow write: if isOperator();
    }
    
    match /nearbyPlaces/{docId} {
      allow read: if isSignedIn();
      allow write: if isOperator();
    }
    
    match /exploreAnalytics/{docId} {
      allow read: if isOperator();
      allow write: if isSignedIn();
    }
    
    match /searchHistory/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    match /savedPlaces/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    match /recommendations/{docId} {
      allow read: if isSignedIn();
      allow write: if isOperator();
    }

    /* ── Catch All ────────────────────────────────────────────────── */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}